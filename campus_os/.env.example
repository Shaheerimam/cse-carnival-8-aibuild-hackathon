# ---------------------------------------------------------------------------
# CampusOS — Environment Variables Template
# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ---------------------------------------------------------------------------

# Firebase App Check debug token
# Required in debug/development builds only.
# Register the token at:
#   https://console.firebase.google.com/project/campusos-hackathon-766f0/appcheck/apps
#
# Pass to the app at run time:
#   flutter run --dart-define=FIREBASE_APPCHECK_DEBUG_TOKEN=<value>
FIREBASE_APPCHECK_DEBUG_TOKEN=your-debug-token-here
